# サーバー設定
PORT=5000
NODE_ENV=development
API_VERSION=v1

# データベース接続
MONGODB_URI=mongodb://localhost:27017/yumetoki_dev
DB_NAME=yumetoki_dev

# 認証・セキュリティ
JWT_SECRET=dev_jwt_secret_key
JWT_EXPIRY=7d
CORS_ORIGIN=http://localhost:3000

# メール送信設定 (開発環境ではメール送信をスキップするかテスト用SMTPサービスを設定)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mailtrap_user
SMTP_PASS=mailtrap_password
MAIL_FROM=noreply@yumetoki.dev
ADMIN_EMAIL=dev@yumetoki.dev

# ロギング
LOG_LEVEL=debug